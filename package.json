{
  "name": "TrueMark",
  "version": "1.3.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/db*\" --exclude \"tests/pipeline*\"",
    "test:integration": "vitest run tests/db.test.ts tests/pipeline.test.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/issuance-worker.ts",
    "worker:check": "tsx scripts/issuance-worker.ts --check",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "fonts:check": "node scripts/check-font-status.js --self-test",
    "integration:key": "tsx --env-file-if-exists=.env.local scripts/integration-key.ts",
    "pdf:backfill": "tsx --env-file-if-exists=.env.local scripts/backfill-pdf-paths.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "next": "^16.4.3",
    "nodemailer": "^7.0.12",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "web-haptics": "^0.0.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
