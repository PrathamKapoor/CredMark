# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gmail Configuration for sending certificates
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Base URL for the app itself (local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated allowlist for API Origin/Referer validation
# Example: https://certificates.iecnmims.com,https://admin.iecnmims.com
ALLOWED_ORIGINS=http://localhost:3000

# Upstash Redis for distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated allowlist of hostnames allowed for template image URLs.
# NEXT_PUBLIC_SUPABASE_URL hostname is always allowed automatically.
# Example: cdn.example.com,assets.example.org
TEMPLATE_IMAGE_ALLOWED_HOSTS=

# Admin Panel Security
# Set to 'true' to enable admin panel access, 'false' to disable
# When disabled, only /verify page is accessible
ADMIN_PANEL_ENABLED=true

# Database upgrade only. Use a direct/session PostgreSQL connection and take a backup.
DATABASE_URL=
ALLOW_DATABASE_MIGRATIONS=false
# Disposable local PostgreSQL only; test runner creates and removes its own database.
DATABASE_TEST_URL=postgres://postgres:test-only-password@localhost:5432/truemark_test

# Durable issuance worker: run separately from the Next.js/Vercel web process.
# capture never sends email and is forbidden in production. Gmail requires explicit enablement.
EMAIL_PROVIDER=disabled
EMAIL_DELIVERY_ENABLED=false
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=120
EMAIL_COOLDOWN_MS=3000

# Optional provider webhook integration. Gmail does not offer this webhook.
# Configure only when implementing a provider that supports signed delivery events.
EMAIL_WEBHOOK_SECRET=
EMAIL_WEBHOOK_PROVIDER=
